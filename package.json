{
  "name": "datacity",
  "version": "0.1.0",
  "private": true,
  "description": "Bibliothèque de référence des données géographiques de Côte d'Ivoire",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "setup": "prisma db push && node prisma/seed.mjs",
    "export:static": "node scripts/export-static.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@prisma/client": "5.18.0",
    "bcryptjs": "2.4.3",
    "jose": "5.6.3",
    "leaflet": "1.9.4",
    "react-leaflet": "4.2.1"
  },
  "devDependencies": {
    "prisma": "5.18.0",
    "tailwindcss": "3.4.7",
    "postcss": "8.4.40",
    "autoprefixer": "10.4.19"
  }
}
